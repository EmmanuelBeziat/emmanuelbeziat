		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-plugin-vue": "^10.10.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.0",
		"lint-staged": "^17.2.0",
		"postcss": "^8.5.23",
		"postcss-html": "^1.8.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"vite": "^8.1.5",
		"vite-plugin-html": "^3.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-stylelint": "^6.3.0",
		"vite-svg-loader": "^5.1.1",
