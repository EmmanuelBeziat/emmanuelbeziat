{
	"name": "emmanuelbeziat",
	"version": "9.4.1",
	"description": "My website, basically. Portfolio, Blog, Resume",
	"type": "module",
	"author": {
		"name": "Emmanuel Béziat",
		"email": "contact@emmanuelbeziat.com"
	},
	"license": "GPLv3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emmanuelbeziat/emmanuelbeziat.git"
	},
	"private": false,
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"update": "git pull && npm-check -u",
		"setup": "npm i && node setup.js",
		"preview": "vite preview --port 3033",
		"lint:style": "stylelint src/**/*.{css,vue}",
		"lint:script": "npx eslint src --ext .vue,.js,.jsx,.cjs,.mjs",
		"test": "npx vitest --run",
		"prepare": "husky"
	},
	"lint-staged": {
		"src/**/*.{vue,css}": [
			"npx stylelint"
		],
		"src/**/*.{vue,js,jsx,cjs,mjs}": [
			"npx eslint"
		]
	},
	"dependencies": {
		"@unhead/vue": "^3.2.3",
		"@vueuse/core": "^14.3.0",
		"core-js": "^3.49.0",
		"dayjs": "^1.11.21",
		"modern-normalize": "^3.0.1",
		"pinia": "^4.0.2",
		"slug": "^12.0.1",
		"toastify-js": "^1.12.0",
		"vue": "^3.5.40",
		"vue-router": "^5.2.0",
		"vue3-sequential-entrance": "^2.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@realfavicongenerator/generate-favicon": "^0.8.4",
